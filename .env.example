# Copy file ini menjadi .env dan isi dengan API key Anda

# Gemini API Key - Dapatkan dari https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model Gemini yang digunakan
# Options: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Threshold Configuration (0-100)
# MATCH_THRESHOLD: Score minimum untuk send message
MATCH_THRESHOLD=70

# AUTO_SEND_THRESHOLD: Score minimum untuk auto-send tanpa review
AUTO_SEND_THRESHOLD=80

# RULE_BASED_THRESHOLD: Score minimum rule-based untuk lanjut ke LLM
RULE_BASED_THRESHOLD=50

# EMBEDDING_SIMILARITY_THRESHOLD: Threshold similarity embedding (0-1)
EMBEDDING_SIMILARITY_THRESHOLD=0.5

# Maximum retry attempts untuk API call
MAX_RETRIES=3

# Rate Limiting untuk Batch/Queue Processing
# Gemini free tier: 15 requests/minute
REQUESTS_PER_MINUTE=15

# Batch processing configuration
BATCH_CHUNK_SIZE=10
DELAY_BETWEEN_CHUNKS=2.0

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=raw_profiles_queue
RABBITMQ_EXCHANGE=profiles_exchange
RABBITMQ_ROUTING_KEY=raw_profile
